# Chave da API do Google Safe Browsing
GOOGLE_API_KEY=sua_chave_aqui

# URL de conexão do PostgreSQL online (Render, Neon, Supabase, etc.)
# Exemplo: postgresql://usuario:senha@host:5432/nome_do_banco
# Se não for informada localmente, o sistema usa SQLite (banco_dados.db) automaticamente.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
